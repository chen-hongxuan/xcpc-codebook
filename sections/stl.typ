  [`size / empty`], [无], [元素数 / `bool`], [返回大小 / 判断空. ], [$O(1)$],
  [`operator[]`], [键 `k`], [`V&`], [访问值; 缺键时插入默认值. ], [$O(log n)$],
  [`at`], [键 `k`], [`V&`], [访问已有值; 缺键时抛异常. ], [$O(log n)$],
  [`find`], [键 `k`], [`it` 或 `end`], [查找此键, 不会插入. ], [$O(log n)$],
  [`count`], [键 `k`], [$0$ 或 $1$], [返回匹配键的数量. ], [$O(log n)$],
  [`insert`], [`{k,v}`], [`pair<it,bool>`], [尝试插入; 已有键不覆盖, 布尔值表示是否新增. ], [$O(log n)$],
  [`emplace`], [`k,v`], [`pair<it,bool>`], [由参数构造待插入项. ], [$O(log n)$],
  [`try_emplace`], [`k,args...`], [`pair<it,bool>`], [仅缺键时用参数构造值. ], [$O(log n)$],
  [`insert_or_assign`], [`k,v`], [`pair<it,bool>`], [缺键插入, 已有则赋值; 新增时为 `true` . ], [$O(log n)$],
  [`erase`], [键 `k`], [$0$ 或 $1$], [删除该键, 返回删除数量. ], [$O(log n)$],
  [`erase`], [`it`], [`it`], [删除一项, 返回后继.], [均摊 $O(1)$],
  [`erase`], [`l,r`], [`it`], [删除区间, 返回后继.], [$O(log n+d)$],
  [`lower_bound`], [键 `k`], [`it` 或 `end`], [首个键 $>=k$ 的位置. ], [$O(log n)$],
